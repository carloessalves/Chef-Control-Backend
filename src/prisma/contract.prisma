// use prisma-next
types {
  Uuid = String @db.Uuid
}

enum RoleName {
  @@type("pg/text@1")
  ADMIN   = "ADMIN"
  MANAGER = "Gerente"
  CHEF    = "Chef"
  WAITER  = "Gracom"
  CASHIER = "Caixa"
}

enum OrderStatus {
  @@type("pg/text@1")
  OPEN       = "OPEN"
  IN_KITCHEN = "IN_KITCHEN"
  READY      = "READY"
  DELIVERED  = "DELIVERED"
  CANCELED   = "CANCELED"
  CLOSED     = "CLOSED"
}

enum OrderItemStatus {
  @@type("pg/text@1")
  PENDING   = "PENDING"
  PREPARING = "PREPARING"
  READY     = "READY"
  DELIVERED = "DELIVERED"
  CANCELED  = "CANCELED"
}

enum PaymentMethod {
  @@type("pg/text@1")
  CASH   = "CASH"
  CREDIT = "CREDIT"
  DEBIT  = "DEBIT"
  PIX    = "PIX"
}

enum TableStatus {
  @@type("pg/text@1")
  AVAILABLE = "AVAILABLE"
  OCCUPIED  = "OCCUPIED"
  RESERVED  = "RESERVED"
}

// ---------- Usuários / Autenticação ----------

model Usuario {
  id          Uuid     @id @default(uuid())
  nome        String
  pin         String
  perfilId    Uuid
  perfil      Perfil   @relation(fields: [perfilId], references: [id])
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm         temporal.updatedAt()

  logsAuditoria LogAuditoria[]
  pedidos       Pedido[]

  @@map("usuarios")
}

model Perfil {
  id          Uuid              @id @default(uuid())
  nome        RoleName          @unique
  descricao   String?
  usuarios    Usuario[]
  permissoes  PerfilPermissao[]

  criadoEm    DateTime @default(now())
  atualizadoEm         temporal.updatedAt()

  @@map("perfis")
}

model Permissao {
  id          Uuid              @id @default(uuid())
  nome        String            @unique
  descricao   String?
  perfis      PerfilPermissao[]

  criadoEm DateTime @default(now())

  @@map("permissoes")
}

model PerfilPermissao {
  perfilId    Uuid
  permissaoId Uuid
  perfil      Perfil    @relation(fields: [perfilId], references: [id])
  permissao   Permissao @relation(fields: [permissaoId], references: [id])

  @@id([perfilId, permissaoId])
  @@map("perfil_permissoes")
}

model LogAuditoria {
  id         Uuid     @id @default(uuid())
  usuarioId  Uuid
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  acao       String
  entidade   String
  entidadeId String?
  metadados  Json?
  criadoEm   DateTime @default(now())

  @@map("logs_auditoria")
  @@index([usuarioId])
  @@index([entidade, entidadeId])
}

// ---------- Cardápio ----------

model Categoria {
  id        Uuid      @id @default(uuid())
  nome      String    @unique
  ativo     Boolean   @default(true)
  produtos  Produto[]

  criadoEm     DateTime @default(now())
  atualizadoEm          temporal.updatedAt()

  @@map("categorias")
}

model Produto {
  id           Uuid          @id @default(uuid())
  nome         String
  descricao    String?
  preco        Decimal
  ativo        Boolean       @default(true)
  categoriaId  Uuid
  categoria    Categoria     @relation(fields: [categoriaId], references: [id])
  itensPedido  ItemPedido[]

  criadoEm     DateTime @default(now())
  atualizadoEm          temporal.updatedAt()

  @@map("produtos")
  @@index([categoriaId])
}


// ---------- Mesas / Comandas ----------

model Mesa {
  id        Uuid        @id @default(uuid())
  numero    Int         @unique
  status    TableStatus @default(AVAILABLE)
  pedidos   Pedido[]

  criadoEm     DateTime @default(now())
  atualizadoEm          temporal.updatedAt()

  @@map("mesas")
}

model Pedido {
  id         Uuid          @id @default(uuid())
  mesaId     Uuid?
  mesa       Mesa?         @relation(fields: [mesaId], references: [id])
  usuarioId  Uuid
  usuario    Usuario       @relation(fields: [usuarioId], references: [id])
  status     OrderStatus   @default(OPEN)
  itens      ItemPedido[]
  pagamentos Pagamento[]

  criadoEm     DateTime @default(now())
  atualizadoEm          temporal.updatedAt()
  fechadoEm    DateTime?

  @@map("pedidos")
  @@index([mesaId])
  @@index([usuarioId])
  @@index([status])
}

model ItemPedido {
  id             Uuid            @id @default(uuid())
  pedidoId       Uuid
  pedido         Pedido          @relation(fields: [pedidoId], references: [id])
  produtoId      Uuid
  produto        Produto         @relation(fields: [produtoId], references: [id])
  quantidade     Int
  precoUnitario  Decimal
  observacoes    String?
  status         OrderItemStatus @default(PENDING)

  criadoEm     DateTime @default(now())
  atualizadoEm          temporal.updatedAt()

  @@map("itens_pedido")
  @@index([pedidoId])
  @@index([produtoId])
}


// ---------- Pagamentos ----------

model Pagamento {
  id       Uuid          @id @default(uuid())
  pedidoId Uuid
  pedido   Pedido        @relation(fields: [pedidoId], references: [id])
  forma    PaymentMethod
  valor    Decimal

  criadoEm DateTime @default(now())

  @@map("pagamentos")
  @@index([pedidoId])
}


