generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PapelUsuario {
  ADMIN
  EMISSOR
  AUDITOR
}

enum CondicaoArmazenamento {
  AMBIENTE
  RESFRIADO
  CONGELADO
}

enum StatusEtiqueta {
  VALIDA
  VENCIDA
  DESCARTADA
  CONSUMIDA
}

enum TipoEvento {
  CREATE
  UPDATE
  DELETE
  EMIT
  REPRINT
  LOGIN
}

enum EntidadeAuditoria {
  Usuario
  Emissor
  Unidade
  CategoriaProduto
  ProdutoManipulado
  RegraValidade
  Dispositivo
  Etiqueta
}

// ============================= Sync Outbox (seção 15 da doc de arquitetura) =============================
// Usado apenas quando SERVER_MODE=local: fila de operações pendentes de sincronização
// com o backend cloud (agregador). Populada em código pelos services relevantes
// (EtiquetasService, ProdutosManipuladosService, EmissoresService) a cada create/update.

enum SyncOutboxStatus {
  PENDENTE
  ENVIADO
  ERRO_PERMANENTE
}

enum SyncOutboxTipo {
  CRIAR_ETIQUETA
  CRIAR_PRODUTO
  ATUALIZAR_PRODUTO
  CRIAR_EMISSOR
  ATUALIZAR_EMISSOR   
  ATUALIZAR_ETIQUETA
}

// ============================= Model Unidade =============================

model Unidade {
  id           String     @id @default(uuid()) @db.Uuid
  nome         String     @unique
  cnpj         String?    @unique
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now()) @db.Timestamptz(6)
  atualizadoEm DateTime   @default(now()) @updatedAt @db.Timestamptz(6)

  usuarios     Usuario[]
  emissores    Emissor[]
  produtos     ProdutoManipulado[]
  etiquetas    Etiqueta[]
  dispositivos Dispositivo[]

  @@map("unidades")
}

// ================================= Model Usuário ==============================

model Usuario {
  id                String            @id @default(uuid()) @db.Uuid
  nome              String            @unique
  funcao            String?
  papel             PapelUsuario
  pin               String
  ativo             Boolean           @default(true)
  unidadeId         String            @db.Uuid
  criadoEm          DateTime          @default(now()) @db.Timestamptz(6)
  atualizadoEm      DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  unidade           Unidade           @relation(fields: [unidadeId], references: [id])
  etiquetasEmitidas Etiqueta[]        @relation("EmissorGestao")
  eventos           EventoAuditoria[]

  @@unique([unidadeId, pin])
  @@index([unidadeId])
  @@map("usuarios")
}

// =================================== Model Emissor =================================

model Emissor {
  id           String     @id @default(uuid()) @db.Uuid
  nome         String
  funcao       String
  unidadeId    String     @db.Uuid
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now()) @db.Timestamptz(6)

  unidade      Unidade    @relation(fields: [unidadeId], references: [id])
  etiquetas    Etiqueta[]

  @@index([unidadeId])
  @@map("emissores")
}

// ================================== Model CategoriaProduto ============================

model CategoriaProduto {
  id       String  @id @default(uuid()) @db.Uuid
  nome     String  @unique
  ativo    Boolean @default(true)

  produtos ProdutoManipulado[]

  @@map("categorias_produto")
}

// ============================= Model ProdutoManipulado ==============================

model ProdutoManipulado {
  id             String              @id @default(uuid()) @db.Uuid
  nome           String
  categoriaId    String?             @db.Uuid
  alergenos      String[]            @default([])
  ativo          Boolean             @default(true)
  unidadeId      String              @db.Uuid
  criadoEm       DateTime            @default(now()) @db.Timestamptz(6)
  atualizadoEm   DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  categoria      CategoriaProduto?   @relation(fields: [categoriaId], references: [id])
  unidade        Unidade             @relation(fields: [unidadeId], references: [id])
  etiquetas      Etiqueta[]

  @@index([unidadeId])
  @@map("produtos_manipulados")
}

// ======================= Model RegraValidade =================================

model RegraValidade {
  id            String                @id @default(uuid()) @db.Uuid
  condicao      CondicaoArmazenamento @unique
  horasValidade Int
  atualizadoEm  DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
}

// ======================== Model Dispositivo ==========================

model Dispositivo {
  id            String     @id @default(uuid()) @db.Uuid
  identificador String     @unique
  nome          String?
  unidadeId     String     @db.Uuid
  ativo         Boolean    @default(true)
  ultimoAcesso  DateTime?  @db.Timestamptz(6)
  criadoEm      DateTime   @default(now()) @db.Timestamptz(6)

  unidade       Unidade                 @relation(fields: [unidadeId], references: [id])
  etiquetas     Etiqueta[]
  reimpressoes  HistoricoReimpressao[]

  // Nota: existe um índice único parcial (unidadeId, nome) WHERE ativo = true,
  // criado via migration SQL raw (não representável nativamente pelo Prisma).
  // Ver prisma/migrations/..._dispositivo_nome_unico_por_unidade/migration.sql
  @@index([unidadeId])
  @@map("dispositivos")
}

// ======================= Model Etiqueta ==================

model Etiqueta {
  id                 String    @id @default(uuid()) @db.Uuid
  produtoId          String    @db.Uuid
  emissorId          String    @db.Uuid
  unidadeId          String    @db.Uuid
  dispositivoId      String    @db.Uuid
  emissorUsuarioId   String?   @db.Uuid
  condicao           CondicaoArmazenamento   // 🆕 antes era String
  lote               String?
  dataManipulacao    DateTime  @db.Timestamptz(6)
  dataValidade       DateTime  @db.Timestamptz(6)
  status             StatusEtiqueta @default(VALIDA)
  motivoReimpressao  String?
  motivoDescarte     String?
  criadoEm           DateTime  @default(now()) @db.Timestamptz(6)
  atualizadoEm       DateTime  @updatedAt @db.Timestamptz(6)

  produto            ProdutoManipulado @relation(fields: [produtoId], references: [id])
  emissor            Emissor           @relation(fields: [emissorId], references: [id])
  unidade            Unidade           @relation(fields: [unidadeId], references: [id])
  dispositivo        Dispositivo       @relation(fields: [dispositivoId], references: [id])
  emissorUsuario     Usuario?          @relation("EmissorGestao", fields: [emissorUsuarioId], references: [id])

  reimpressoes       HistoricoReimpressao[]

  @@map("etiquetas")
}

// ================ Model HistoricoReimpressao ====================
model HistoricoReimpressao {
  id             String    @id @default(uuid()) @db.Uuid
  etiquetaId     String    @db.Uuid
  motivo         String
  dispositivoId  String    @db.Uuid
  criadoEm       DateTime  @default(now()) @db.Timestamptz(6)

  etiqueta       Etiqueta    @relation(fields: [etiquetaId], references: [id])
  dispositivo    Dispositivo @relation(fields: [dispositivoId], references: [id])

  @@map("historico_reimpressoes")
  @@index([etiquetaId])
}

// ===================== Model EventoAuditoria =====================
model EventoAuditoria {
  id             String            @id @default(uuid()) @db.Uuid
  usuarioId      String?           @db.Uuid
  papelNoMomento PapelUsuario?
  tipoEvento     TipoEvento
  entidade       EntidadeAuditoria   // <- antes era String
  entidadeId     String?
  dadosAntes     Json?             @db.JsonB
  dadosDepois    Json?             @db.JsonB
  dispositivoId  String?           @db.Uuid
  criadoEm       DateTime          @default(now()) @db.Timestamptz(6)

  usuario        Usuario?          @relation(fields: [usuarioId], references: [id])

  @@index([entidade, entidadeId])
  @@index([usuarioId])
  @@map("eventos_auditoria")
}

// ============================= Model SyncOutbox =============================
// Fila de sincronização local -> cloud (ver seção 15 da documentação de arquitetura).
// Só é populada/consumida quando SERVER_MODE=local. Em SERVER_MODE=cloud, a tabela
// existe (mesmo schema em ambos os ambientes), mas fica sempre vazia.

model SyncOutbox {
  id                 String            @id @default(uuid()) @db.Uuid
  tipo               SyncOutboxTipo
  payload            Json              @db.JsonB
  status             SyncOutboxStatus  @default(PENDENTE)
  tentativas         Int               @default(0)
  proximaTentativaEm DateTime?         @db.Timestamptz(6)
  erro               String?
  criadoEm           DateTime          @default(now()) @db.Timestamptz(6)
  atualizadoEm       DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, proximaTentativaEm])
  @@map("sync_outbox")
}
