generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PapelUsuario {
  ADMIN
  EMISSOR
  AUDITOR
}

enum CondicaoArmazenamento {
  AMBIENTE
  RESFRIADO
  CONGELADO
}

enum StatusEtiqueta {
  VALIDA
  VENCIDA
  DESCARTADA
  CONSUMIDA
}

enum TipoEvento {
  CREATE
  UPDATE
  DELETE
  EMIT
  REPRINT
  LOGIN
}

// ============= Model Unidade ===============
model Unidade {
  id           String     @id @default(uuid()) @db.Uuid
  nome         String     @unique
  cnpj         String?
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now()) @db.Timestamptz(6)
  atualizadoEm DateTime   @default(now()) @updatedAt @db.Timestamptz(6)

  usuarios     Usuario[]
  emissores    Emissor[]
  produtos     ProdutoManipulado[]
  etiquetas    Etiqueta[]
  dispositivos Dispositivo[]

  @@map("unidades")
}

// ============= Model Usuário ===============
model Usuario {
  id                String            @id @default(uuid()) @db.Uuid
  nome              String
  funcao            String?
  papel             PapelUsuario
  pin               String
  ativo             Boolean           @default(true)
  unidadeId         String            @db.Uuid
  criadoEm          DateTime          @default(now()) @db.Timestamptz(6)
  atualizadoEm      DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  unidade           Unidade           @relation(fields: [unidadeId], references: [id])
  etiquetasEmitidas Etiqueta[]        @relation("EmissorGestao")
  eventos           EventoAuditoria[]

  @@unique([unidadeId, pin])
  @@index([unidadeId])
  @@map("usuarios")
}

// ============= Model Emissor ===============
model Emissor {
  id           String     @id @default(uuid()) @db.Uuid
  nome         String
  funcao       String
  unidadeId    String     @db.Uuid
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now()) @db.Timestamptz(6)

  unidade      Unidade    @relation(fields: [unidadeId], references: [id])
  etiquetas    Etiqueta[]

  @@index([unidadeId])
  @@map("emissores")
}

// ============= Model CategoriaProduto ===============
model CategoriaProduto {
  id       String  @id @default(uuid()) @db.Uuid
  nome     String  @unique
  ativo    Boolean @default(true)

  produtos ProdutoManipulado[]

  @@map("categorias_produto")
}

// ============= Model ProdutoManipulado ===============
model ProdutoManipulado {
  id             String              @id @default(uuid()) @db.Uuid
  nome           String
  categoriaId    String?             @db.Uuid
  alergenos      String[]            @default([])
  ativo          Boolean             @default(true)
  unidadeId      String              @db.Uuid
  criadoEm       DateTime            @default(now()) @db.Timestamptz(6)
  atualizadoEm   DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  categoria      CategoriaProduto?   @relation(fields: [categoriaId], references: [id])
  unidade        Unidade             @relation(fields: [unidadeId], references: [id])
  etiquetas      Etiqueta[]

  @@index([unidadeId])
  @@map("produtos_manipulados")
}

// ============= Model RegraValidade ===============
model RegraValidade {
  id            String                @id @default(uuid()) @db.Uuid
  condicao      CondicaoArmazenamento @unique
  horasValidade Int
  atualizadoEm  DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
}

// ============= Model Dispositivo ===============
model Dispositivo {
  id            String     @id @default(uuid()) @db.Uuid
  identificador String     @unique
  nome          String?
  unidadeId     String     @db.Uuid
  ativo         Boolean    @default(true)
  ultimoAcesso  DateTime?  @db.Timestamptz(6)
  criadoEm      DateTime   @default(now()) @db.Timestamptz(6)

  unidade       Unidade    @relation(fields: [unidadeId], references: [id])
  etiquetas     Etiqueta[]

  @@index([unidadeId])
  @@map("dispositivos")
}

// ============= Model Etiqueta ===============
model Etiqueta {
  id                String                @id @default(uuid()) @db.Uuid
  produtoId         String                @db.Uuid
  emissorId         String                @db.Uuid
  usuarioGestaoId   String?               @db.Uuid
  unidadeId         String                @db.Uuid
  dispositivoId     String                @db.Uuid

  condicao          CondicaoArmazenamento
  lote              String?
  dataManipulacao   DateTime              @db.Timestamptz(6)
  dataValidade      DateTime              @db.Timestamptz(6)
  status            StatusEtiqueta        @default(VALIDA)

  motivoReimpressao String?
  motivoDescarte    String?

  criadoEm          DateTime              @default(now()) @db.Timestamptz(6)
  sincronizadoEm    DateTime?             @db.Timestamptz(6)

  produto           ProdutoManipulado     @relation(fields: [produtoId], references: [id])
  emissor            Emissor              @relation(fields: [emissorId], references: [id])
  usuarioGestao     Usuario?              @relation("EmissorGestao", fields: [usuarioGestaoId], references: [id])
  unidade           Unidade               @relation(fields: [unidadeId], references: [id])
  dispositivo       Dispositivo           @relation(fields: [dispositivoId], references: [id])

  @@index([produtoId])
  @@index([unidadeId])
  @@index([status])
  @@index([dataValidade])
  @@map("etiquetas")
}

// ============= Model EventoAuditoria ===============
model EventoAuditoria {
  id             String        @id @default(uuid()) @db.Uuid
  usuarioId      String?       @db.Uuid
  papelNoMomento PapelUsuario?
  tipoEvento     TipoEvento
  entidade       String
  entidadeId     String?
  dadosAntes     Json?         @db.JsonB
  dadosDepois    Json?         @db.JsonB
  dispositivoId  String?       @db.Uuid
  criadoEm       DateTime      @default(now()) @db.Timestamptz(6)

  usuario        Usuario?      @relation(fields: [usuarioId], references: [id])

  @@index([entidade, entidadeId])
  @@index([usuarioId])
  @@map("eventos_auditoria")
}
